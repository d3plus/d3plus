{
  "name": "@d3plus/vue",
  "version": "4.9.0",
  "description": "Vue 3 components for d3plus visualizations.",
  "license": "MIT",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./es/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "es",
    "types"
  ],
  "homepage": "https://d3plus.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3plus/d3plus.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "vue",
    "d3",
    "d3plus",
    "data",
    "visualization"
  ],
  "scripts": {
    "build:esm": "node ../../scripts/build-esm.js",
    "build:types": "tsc",
    "dev": "node ../../scripts/dev.js",
    "test": "vitest run --config ../../vitest.config.ts --project vue",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project vue --coverage --coverage.exclude='packages/!(vue)/**' --coverage.exclude='test/**' --coverage.reportsDirectory=packages/vue/coverage"
  },
  "dependencies": {
    "@d3plus/core": "workspace:*",
    "@d3plus/dom": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "catalog:",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "vue": "^3.5.44"
  }
}
