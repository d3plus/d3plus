{
  "name": "@d3plus/export",
  "version": "4.9.0",
  "description": "Export methods for transforming and downloading SVG.",
  "license": "MIT",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./es/index.js"
    }
  },
  "jsdelivr": "./umd/d3plus-export.full.min.js",
  "unpkg": "./umd/d3plus-export.full.min.js",
  "sideEffects": false,
  "files": [
    "umd/*.js",
    "es",
    "types"
  ],
  "homepage": "https://d3plus.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3plus/d3plus.git",
    "directory": "packages/export"
  },
  "keywords": [
    "export",
    "d3",
    "d3plus",
    "data",
    "visualization"
  ],
  "scripts": {
    "build:esm": "node ../../scripts/build-esm.js",
    "build:types": "tsc",
    "build:umd": "node ../../scripts/build-umd.js",
    "dev": "node ../../scripts/dev.js",
    "test": "vitest run --config ../../vitest.config.ts --project export",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project export --coverage --coverage.exclude='packages/!(export)/**' --coverage.exclude='test/**' --coverage.reportsDirectory=packages/export/coverage"
  },
  "dependencies": {
    "html-to-image": "^1.11.11"
  }
}
