{
  "name": "@d3plus/render",
  "version": "4.8.0",
  "description": "A backend-agnostic scene graph and pluggable SVG/Canvas renderers for d3plus visualizations.",
  "license": "MIT",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./es/index.js"
    }
  },
  "jsdelivr": "./umd/d3plus-render.full.min.js",
  "unpkg": "./umd/d3plus-render.full.min.js",
  "sideEffects": false,
  "files": [
    "umd/*.js",
    "es",
    "types"
  ],
  "homepage": "https://d3plus.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3plus/d3plus.git",
    "directory": "packages/render"
  },
  "keywords": [
    "canvas",
    "svg",
    "render",
    "scene-graph",
    "d3",
    "d3plus",
    "data",
    "visualization"
  ],
  "scripts": {
    "build:esm": "node ../../scripts/build-esm.js",
    "build:types": "tsc",
    "build:umd": "node ../../scripts/build-umd.js",
    "dev": "node ../../scripts/dev.js",
    "test": "vitest run --config ../../vitest.config.ts --project render",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project render --coverage --coverage.include='packages/render/{index.ts,src/**}' --coverage.reportsDirectory=packages/render/coverage"
  },
  "dependencies": {
    "@d3plus/math": "workspace:*",
    "d3-color": "catalog:",
    "d3-interpolate": "catalog:",
    "d3-interpolate-path": "^2.3.0",
    "d3-selection": "catalog:",
    "d3-shape": "catalog:",
    "d3-timer": "^3.0.1",
    "d3-transition": "catalog:",
    "textures": "^1.2.3"
  }
}
