{
  "name": "@d3plus/svelte",
  "version": "4.8.0",
  "description": "Svelte action for rendering d3plus visualizations.",
  "license": "MIT",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./es/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "es",
    "types"
  ],
  "homepage": "https://d3plus.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3plus/d3plus.git",
    "directory": "packages/svelte"
  },
  "keywords": [
    "svelte",
    "d3",
    "d3plus",
    "data",
    "visualization"
  ],
  "scripts": {
    "build:esm": "node ../../scripts/build-esm.js",
    "build:types": "tsc",
    "dev": "node ../../scripts/dev.js",
    "test": "vitest run --config ../../vitest.config.ts --project svelte",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project svelte --coverage --coverage.exclude='packages/!(svelte)/**' --coverage.exclude='test/**' --coverage.reportsDirectory=packages/svelte/coverage"
  },
  "dependencies": {
    "@d3plus/dom": "workspace:*"
  },
  "devDependencies": {
    "@d3plus/core": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.56.5",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  }
}
