{
  "name": "@d3plus/locales",
  "version": "4.8.0",
  "description": "International localizations for number, date, and UI labels.",
  "license": "MIT",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./es/index.js"
    }
  },
  "jsdelivr": "./umd/d3plus-locales.full.min.js",
  "unpkg": "./umd/d3plus-locales.full.min.js",
  "sideEffects": false,
  "files": [
    "umd/*.js",
    "es",
    "types"
  ],
  "homepage": "https://d3plus.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3plus/d3plus.git",
    "directory": "packages/locales"
  },
  "keywords": [
    "locales",
    "d3",
    "d3plus",
    "data",
    "visualization"
  ],
  "scripts": {
    "build:esm": "node ../../scripts/build-esm.js",
    "build:types": "tsc",
    "build:umd": "node ../../scripts/build-umd.js",
    "dev": "node ../../scripts/dev.js",
    "test": "vitest run --config ../../vitest.config.ts --project locales",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project locales --coverage --coverage.include='packages/locales/{index.ts,src/**}' --coverage.reportsDirectory=packages/locales/coverage"
  }
}
