{
  "name": "@d3plus/element",
  "version": "4.8.0",
  "description": "Framework-agnostic custom elements (Web Components) for d3plus visualizations.",
  "license": "MIT",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./es/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "es",
    "types"
  ],
  "homepage": "https://d3plus.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3plus/d3plus.git",
    "directory": "packages/element"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "d3",
    "d3plus",
    "data",
    "visualization"
  ],
  "scripts": {
    "build:esm": "node ../../scripts/build-esm.js",
    "build:types": "tsc",
    "dev": "node ../../scripts/dev.js",
    "test": "vitest run --config ../../vitest.config.ts --project element",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project element --coverage --coverage.exclude='packages/!(element)/**' --coverage.exclude='test/**' --coverage.reportsDirectory=packages/element/coverage"
  },
  "dependencies": {
    "@d3plus/core": "workspace:*",
    "@d3plus/dom": "workspace:*"
  },
  "devDependencies": {
    "vite": "catalog:"
  }
}
