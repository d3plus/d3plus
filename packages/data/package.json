{
  "name": "@d3plus/data",
  "version": "4.8.0",
  "description": "JavaScript data loading, manipulation, and analysis functions.",
  "license": "MIT",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./es/index.js"
    }
  },
  "jsdelivr": "./umd/d3plus-data.full.min.js",
  "unpkg": "./umd/d3plus-data.full.min.js",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "umd/*.js",
    "es",
    "types"
  ],
  "homepage": "https://d3plus.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3plus/d3plus.git",
    "directory": "packages/data"
  },
  "keywords": [
    "data",
    "d3",
    "d3plus",
    "data",
    "visualization"
  ],
  "scripts": {
    "build:esm": "node ../../scripts/build-esm.js",
    "build:types": "tsc",
    "build:umd": "node ../../scripts/build-umd.js",
    "dev": "node ../../scripts/dev.js",
    "lint": "eslint index.ts src && eslint --global=it test",
    "test": "pnpm run lint && mocha 'test/**/*-test.js'",
    "test:coverage": "c8 -r text -r lcov --src src mocha 'test/**/*-test.js'"
  },
  "dependencies": {
    "d3-array": "catalog:",
    "d3-fetch": "^3.0.1"
  }
}