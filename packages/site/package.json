{
  "name": "@d3plus/site",
  "version": "4.10.0",
  "description": "The d3plus.org documentation site.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://d3plus.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3plus/d3plus.git",
    "directory": "packages/site"
  },
  "scripts": {
    "manifest": "cd ../.. && node scripts/docs/docs.js --manifest=packages/site/src/data",
    "dev": "astro dev --port 4000",
