    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@d3plus/color": "workspace:*",
    "@d3plus/core": "workspace:*",
    "@d3plus/data": "workspace:*",
    "@d3plus/dom": "workspace:*",
    "@d3plus/format": "workspace:*",
    "@d3plus/ssr": "workspace:*",
    "@lezer/highlight": "^1.2.5",
    "@napi-rs/canvas": "^1.0.11",
    "acorn": "^8.19.0",
    "astro": "^7.4.4",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
