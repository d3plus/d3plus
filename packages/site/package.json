    "preview": "astro preview --port 4000",
    "check": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project site"
  },
  "devDependencies": {
    "@astrojs/preact": "^6.1.1",
    "@astrojs/starlight": "^0.42.7",
