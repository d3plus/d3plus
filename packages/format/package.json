{
  "name": "@d3plus/format",
  "version": "4.8.0",
  "description": "JavaScript formatters for localized numbers and dates.",
  "license": "MIT",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./es/index.js"
    }
  },
  "jsdelivr": "./umd/d3plus-format.full.min.js",
  "unpkg": "./umd/d3plus-format.full.min.js",
  "sideEffects": false,
  "files": [
    "umd/*.js",
    "es",
    "types"
  ],
  "homepage": "https://d3plus.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3plus/d3plus.git",
    "directory": "packages/format"
  },
  "keywords": [
    "format",
    "d3",
    "d3plus",
    "data",
    "visualization"
  ],
  "scripts": {
    "build:esm": "node ../../scripts/build-esm.js",
    "build:types": "tsc",
    "build:umd": "node ../../scripts/build-umd.js",
    "dev": "node ../../scripts/dev.js",
    "test": "vitest run --config ../../vitest.config.ts --project format",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project format --coverage --coverage.exclude='packages/!(format)/**' --coverage.exclude='test/**' --coverage.reportsDirectory=packages/format/coverage"
  },
  "dependencies": {
    "@d3plus/locales": "workspace:*",
    "d3-format": "^3.1.0",
    "d3-time": "catalog:",
    "d3-time-format": "catalog:"
  }
}
