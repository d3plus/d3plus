{
  "name": "@d3plus/angular",
  "version": "4.10.0",
  "description": "Angular components for d3plus visualizations.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://d3plus.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3plus/d3plus.git",
    "directory": "packages/angular"
  },
  "keywords": [
    "angular",
    "d3",
    "d3plus",
    "data",
    "visualization"
  ],
  "publishConfig": {
    "directory": "dist"
  },
  "scripts": {
    "build:esm": "ng-packagr -p ng-package.json",
    "build": "ng-packagr -p ng-package.json",
    "dev": "node ../../scripts/dev.js",
    "test": "vitest run --config ../../vitest.config.ts --project angular",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project angular --coverage --coverage.exclude='packages/!(angular)/**' --coverage.exclude='test/**' --coverage.reportsDirectory=packages/angular/coverage"
  },
  "dependencies": {
    "@d3plus/dom": "workspace:*",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": ">=20.0.0",
    "@angular/core": ">=20.0.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.1",
    "@angular/build": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@d3plus/core": "workspace:*",
    "ng-packagr": "^22.2.4",
    "rxjs": "^7.8.0",
    "vite": "catalog:",
    "zone.js": "^0.16.3"
  }
}
