{
  "name": "@d3plus/math",
  "version": "4.8.0",
  "description": "Mathematical functions to aid in calculating visualizations.",
  "license": "MIT",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./es/index.js"
    }
  },
  "jsdelivr": "./umd/d3plus-math.full.min.js",
  "unpkg": "./umd/d3plus-math.full.min.js",
  "sideEffects": false,
  "files": [
    "umd/*.js",
    "es",
    "types"
  ],
  "homepage": "https://d3plus.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3plus/d3plus.git",
    "directory": "packages/math"
  },
  "keywords": [
    "math",
    "d3",
    "d3plus",
    "data",
    "visualization"
  ],
  "scripts": {
    "build:esm": "node ../../scripts/build-esm.js",
    "build:types": "tsc",
    "build:umd": "node ../../scripts/build-umd.js",
    "dev": "node ../../scripts/dev.js",
    "test": "vitest run --config ../../vitest.config.ts --project math",
    "test:coverage": "vitest run --config ../../vitest.config.ts --project math --coverage --coverage.include='packages/math/{index.ts,src/**}' --coverage.reportsDirectory=packages/math/coverage"
  },
  "dependencies": {
    "d3-array": "catalog:",
    "d3-polygon": "catalog:"
  }
}
