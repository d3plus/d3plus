{
  "name": "@d3plus/core",
  "version": "4.8.0",
  "description": "Data visualization made easy. A javascript library that extends the popular D3.js to enable fast and beautiful visualizations.",
  "license": "MIT",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./es/index.js"
    },
    "./internal": {
      "types": "./types/internal.d.ts",
      "default": "./es/internal.js"
    }
  },
  "jsdelivr": "./umd/d3plus-core.full.min.js",
  "unpkg": "./umd/d3plus-core.full.min.js",
  "sideEffects": false,
  "files": [
    "umd/*.js",
    "es",
    "types"
  ],
  "homepage": "https://d3plus.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3plus/d3plus.git",
    "directory": "packages/core"
  },
  "keywords": [
    "charts",
    "d3",
    "d3plus",
    "data",
    "visualization"
  ],
  "scripts": {
    "build:esm": "node ../../scripts/build-esm.js",
    "build:types": "tsc",
    "build:umd": "node ../../scripts/build-umd.js",
    "dev": "node ../../scripts/dev.js",
    "test": "mocha 'test/**/*-test.js'",
    "test:dev-pages": "mocha test/dev-pages.js",
    "test:coverage": "c8 -r text -r lcov --src src --exclude-after-remap --include 'src/**' --include '*.ts' mocha 'test/**/*-test.js'"
  },
  "dependencies": {
    "@d3plus/color": "workspace:*",
    "@d3plus/data": "workspace:*",
    "@d3plus/dom": "workspace:*",
    "@d3plus/format": "workspace:*",
    "@d3plus/locales": "workspace:*",
    "@d3plus/math": "workspace:*",
    "@d3plus/render": "workspace:*",
    "@d3plus/text": "workspace:*",
    "@floating-ui/dom": "^1.6.0",
    "d3-array": "catalog:",
    "d3-brush": "^3.0.0",
    "d3-chord": "^3.0.1",
    "d3-color": "catalog:",
    "d3-composite-projections": "^1.4.0",
    "d3-force": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-interpolate": "catalog:",
    "d3-polygon": "catalog:",
    "d3-scale": "catalog:",
    "d3-selection": "catalog:",
    "d3-shape": "catalog:",
    "d3-tile": "^1.0.0",
    "d3-time": "catalog:",
    "d3-time-format": "catalog:",
    "d3-transition": "catalog:",
    "d3-zoom": "^3.0.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "^1.0.2",
    "playwright": "1.59.1"
  }
}