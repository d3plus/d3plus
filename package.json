{
  "name": "d3plus",
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
  "version": "4.10.0",
  "description": "Data visualization made easy. A javascript library that extends the popular D3.js to enable fast and beautiful visualizations.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://d3plus.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3plus/d3plus.git"
  },
  "keywords": [
    "charts",
    "d3",
    "d3plus",
    "data",
    "visualization"
  ],
  "scripts": {
    "dev:index": "node scripts/dev-index.js",
    "docs": "node scripts/docs/docs.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "release": "node scripts/release.js",
    "test": "pnpm lint && vitest run",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "test:dev-pages": "vitest run --config vitest.dev-pages.config.ts",
    "test:built": "D3PLUS_TEST_TARGET=es vitest run --project ssr --project core --project core-browser packages/ssr/ packages/core/test/pipeline-parity-test.js packages/core/test/visual-regression.browser-test.js"
  },
